<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.dhruva.systemmonitor.controllers.DashboardController">

    <left>

        <VBox fx:id="sidebar"
              prefWidth="240"
              spacing="12"
              alignment="TOP_LEFT"
              styleClass="sidebar">

            <padding>
                <Insets top="24"
                        right="18"
                        bottom="24"
                        left="18"/>
            </padding>

            <VBox spacing="2">

                <Label text="System Monitor"
                       styleClass="sidebar-title"/>

                <Label text="System Resource Monitor"
                       styleClass="sidebar-subtitle"/>

            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <Button fx:id="systemBtn"
                    text="System"
                    onAction="#showSystem"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button fx:id="performanceBtn"
                    text="Performance"
                    onAction="#showPerformance"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

            <Button fx:id="processesBtn"
                    text="Processes"
                    onAction="#showProcesses"
                    maxWidth="Infinity"
                    styleClass="nav-button"/>

        </VBox>

    </left>

    <center>

        <StackPane fx:id="contentPane"
                   styleClass="page"/>

    </center>

</BorderPane>